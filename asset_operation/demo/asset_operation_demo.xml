<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="account_asset_demo_acer" model="account.asset">
            <field name="name">Acer Laptop NE56R</field>
            <field name="original_value">1200</field>
            <field name="already_depreciated_amount_import">480</field>
            <field name="acquisition_date" eval="(DateTime.today() - relativedelta(years=2)).strftime('%Y-%m-%d')"/>
            <field name="prorata_computation_type">none</field>
            <field name="journal_id" model="account.journal" search="[('type', '=', 'general'),
                ('id', '!=', obj().env.user.company_id.currency_exchange_journal_id.id)]"/>
            <field name="account_asset_id" model="account.account" search="[('account_type', '=', 'asset_fixed'),
                ('company_ids', '=', ref('base.main_company'))]"/>
            <field name="account_depreciation_id" model="account.account" search="[('account_type', '=', 'asset_fixed'),
                ('company_ids', '=', ref('base.main_company'))]"/>
            <field name="account_depreciation_expense_id" model="account.account" search="[
                ('account_type', '=', 'expense'), ('tag_ids', 'in', [ref('account.account_tag_operating')]),
                ('company_ids', '=', ref('base.main_company'))]"/>
            <field name="asset_group_id" ref="account_asset.account_asset_group_demo"/>
            <field name="state">open</field>
        </record>

        <record id="account_asset_demo_hp" model="account.asset">
            <field name="name">HP Laptop 17-j059nr</field>
            <field name="original_value">1500</field>
            <field name="already_depreciated_amount_import">300</field>
            <field name="acquisition_date" eval="(DateTime.today() - relativedelta(years=1)).strftime('%Y-%m-%d')"/>
            <field name="prorata_computation_type">none</field>
            <field name="journal_id" model="account.journal" search="[('type', '=', 'general'),
                ('id', '!=', obj().env.user.company_id.currency_exchange_journal_id.id)]"/>
            <field name="account_asset_id" model="account.account" search="[('account_type', '=', 'asset_fixed'),
                ('company_ids', '=', ref('base.main_company'))]"/>
            <field name="account_depreciation_id" model="account.account" search="[('account_type', '=', 'asset_fixed'),
                ('company_ids', '=', ref('base.main_company'))]"/>
            <field name="account_depreciation_expense_id" model="account.account" search="[
                ('account_type', '=', 'expense'), ('tag_ids', 'in', [ref('account.account_tag_operating')]),
                ('company_ids', '=', ref('base.main_company'))]"/>
            <field name="asset_group_id" ref="account_asset.account_asset_group_demo"/>
            <field name="state">open</field>
        </record>

        <!-- current holders of the standard demo equipment -->
        <record id="maintenance.equipment_computer3" model="maintenance.equipment">
            <field name="account_asset_id" ref="account_asset_demo_acer"/>
            <field name="equipment_assign_to">employee</field>
            <field name="employee_id" ref="hr.employee_qdp"/>
            <field name="assign_date" eval="(DateTime.today() - relativedelta(days=45)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="maintenance.equipment_computer9" model="maintenance.equipment">
            <field name="account_asset_id" ref="account_asset_demo_hp"/>
            <field name="equipment_assign_to">employee</field>
            <field name="employee_id" ref="hr.employee_ngh"/>
            <field name="assign_date" eval="(DateTime.today() - relativedelta(days=20)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="maintenance.equipment_monitor1" model="maintenance.equipment">
            <field name="equipment_assign_to">employee</field>
            <field name="employee_id" ref="hr.employee_vad"/>
            <field name="assign_date" eval="(DateTime.today() - relativedelta(days=10)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- operation history matching the holders above: each return right after the assignation it closes -->
        <record id="asset_operation_demo_acer_marc" model="asset.operation">
            <field name="equipment_id" ref="maintenance.equipment_computer3"/>
            <field name="employee_id" ref="hr.employee_qdp"/>
            <field name="date" eval="(DateTime.today() - relativedelta(days=45)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="asset_operation_demo_hp_ronnie" model="asset.operation">
            <field name="equipment_id" ref="maintenance.equipment_computer9"/>
            <field name="employee_id" ref="hr.employee_al"/>
            <field name="date" eval="(DateTime.today() - relativedelta(days=120)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="asset_operation_demo_hp_ronnie_return" model="asset.operation">
            <field name="equipment_id" ref="maintenance.equipment_computer9"/>
            <field name="employee_id" ref="hr.employee_al"/>
            <field name="type">return</field>
            <field name="assignation_id" ref="asset_operation_demo_hp_ronnie"/>
            <field name="date" eval="(DateTime.today() - relativedelta(days=30)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="asset_operation_demo_hp_jeffrey" model="asset.operation">
            <field name="equipment_id" ref="maintenance.equipment_computer9"/>
            <field name="employee_id" ref="hr.employee_ngh"/>
            <field name="date" eval="(DateTime.today() - relativedelta(days=20)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="asset_operation_demo_monitor_tina" model="asset.operation">
            <field name="equipment_id" ref="maintenance.equipment_monitor1"/>
            <field name="employee_id" ref="hr.employee_vad"/>
            <field name="date" eval="(DateTime.today() - relativedelta(days=10)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="asset_operation_demo_monitor_abigail" model="asset.operation">
            <field name="equipment_id" ref="maintenance.equipment_monitor6"/>
            <field name="employee_id" ref="hr.employee_hne"/>
            <field name="date" eval="(DateTime.today() - relativedelta(days=200)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="asset_operation_demo_monitor_abigail_return" model="asset.operation">
            <field name="equipment_id" ref="maintenance.equipment_monitor6"/>
            <field name="employee_id" ref="hr.employee_hne"/>
            <field name="type">return</field>
            <field name="assignation_id" ref="asset_operation_demo_monitor_abigail"/>
            <field name="date" eval="(DateTime.today() - relativedelta(days=100)).strftime('%Y-%m-%d')"/>
        </record>

    </data>
</odoo>
